{
  "name": "threadpeak-ux-ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4301",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "check:architecture": "node --test tests/architecture-baseline.test.mjs",
    "check:contracts": "node --test packages/contracts/tests/*.test.mjs packages/api-client/tests/*.test.mjs tests/runtime-contracts-compat.test.mjs",
    "check:product-invariants": "node --test tests/architecture-governance.test.mjs",
    "test": "node --test tests/*.test.mjs packages/contracts/tests/*.test.mjs packages/api-client/tests/*.test.mjs packages/runtime-store/tests/*.test.mjs src/path-lab/*.test.mjs src/path-planning/*.test.mjs src/path-3d/*.test.mjs"
  },
  "dependencies": {
    "@threadpeak/api-client": "0.1.0",
    "@threadpeak/contracts": "0.1.0",
    "@threadpeak/runtime-store": "0.1.0",
    "katex": "0.16.47",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
