{
  "name": "threadpeak-ux-ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4301",
    "server": "node --experimental-strip-types server/main.ts",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "check:architecture": "node --test tests/architecture-baseline.test.mjs",
    "check:contracts": "node --test packages/contracts/tests/*.test.mjs packages/api-client/tests/*.test.mjs tests/runtime-contracts-compat.test.mjs",
    "check:product-invariants": "node --test tests/architecture-governance.test.mjs tests/product-invariants.test.mjs",
    "test:agent-runtime": "node --test server/agent-runtime/*.test.mjs",
    "test:agent-runtime:live": "node --test --test-concurrency=1 --test-timeout=180000 server/agent-runtime/live.gate.mjs",
    "test:path-generation": "node --test server/path-generation/*.test.mjs",
    "test:path-generation:live": "node --test --test-concurrency=1 --test-timeout=180000 server/path-generation/live.gate.mjs",
    "test:first-learning": "node --test server/first-learning/*.test.mjs src/session/request-first-entry.test.mjs",
    "test:first-learning:live": "node --test --test-concurrency=1 --test-timeout=180000 server/first-learning/live.gate.mjs",
    "test:follow-up": "node --test server/follow-up/*.test.mjs src/session/resolve-follow-up-host.test.mjs src/session/request-follow-up.test.mjs",
    "test:follow-up:live": "node --test --test-concurrency=1 --test-timeout=180000 server/follow-up/live.gate.mjs",
    "test:authors": "node --test server/authors/*.test.mjs src/session/request-ask-author.test.mjs src/session/request-author-search.test.mjs src/session/request-author-network.test.mjs src/session/resolve-ask-author.test.mjs src/session/resolve-author-search.test.mjs src/session/resolve-author-network.test.mjs src/session/ask-authors.test.mjs",
    "test:authors:live": "node --test --test-concurrency=1 --test-timeout=180000 server/authors/live.gate.mjs",
    "test:ordinary-chat": "node --test server/ordinary-chat/*.test.mjs src/chat/request-ordinary-answer.test.mjs src/chat/build-ordinary-chat-context.test.mjs src/chat/resolve-chat-launch.test.mjs",
    "test:ordinary-chat:live": "node --test --test-concurrency=1 --test-timeout=180000 server/ordinary-chat/live.gate.mjs",
    "test": "node --test tests/*.test.mjs packages/contracts/tests/*.test.mjs packages/api-client/tests/*.test.mjs packages/runtime-store/tests/*.test.mjs src/path-planning/*.test.mjs src/path-3d/*.test.mjs src/session/*.test.mjs src/chat/*.test.mjs src/knowledge-canvas/*.test.mjs src/workspace/*.test.mjs src/lib/*.test.mjs src/materials/*.test.mjs src/learning-v2/*.test.mjs src/*.test.mjs server/*.test.mjs server/identity/*.test.mjs server/knowledge/*.test.mjs server/agent-runtime/*.test.mjs server/path-generation/*.test.mjs server/first-learning/*.test.mjs server/follow-up/*.test.mjs server/authors/*.test.mjs server/ordinary-chat/*.test.mjs server/durable/*.test.mjs",
    "test:durable": "node --test server/durable/*.test.mjs",
    "test:postgres": "node --test server/durable/postgres.gate.mjs",
    "ops:queue": "node --experimental-strip-types server/durable/ops.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@threadpeak/api-client": "0.1.0",
    "@threadpeak/contracts": "0.1.0",
    "@threadpeak/runtime-store": "0.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "katex": "0.16.47",
    "mdast-util-from-markdown": "2.0.3",
    "motion": "^13.2.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "thinking-orbs": "^0.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
