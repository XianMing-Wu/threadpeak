@@ -0,0 +1,16 @@
+import type * as THREE from "three";
+
+/** VSM reads two equally-sized targets; retaining mapPass after a resize
+ * makes UV sampling use the old extent and darkens the entire scene. */
+export function releaseShadowTargets(shadow: THREE.LightShadow): void {
+  const targets = new Set([shadow.map, shadow.mapPass]);
+  for (const target of targets) {
+    if (!target) continue;
+    target.depthTexture?.dispose();
+    target.depthTexture = null;
+    target.dispose();
+  }
+  shadow.map = null;
+  shadow.mapPass = null;
+  shadow.needsUpdate = true;
+}
