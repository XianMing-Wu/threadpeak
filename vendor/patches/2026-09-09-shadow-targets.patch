@@ -0,0 +1,21 @@
+import assert from "node:assert/strict";
+import * as THREE from "three";
+import { releaseShadowTargets } from "./ShadowResources";
+const shadow = new THREE.DirectionalLight().shadow;
+let disposed = 0;
+for (const size of [2048, 4096, 2048, 4096]) {
+  shadow.map = new THREE.WebGLRenderTarget(size, size);
+  shadow.map.depthTexture = new THREE.DepthTexture(size, size);
+  shadow.mapPass = new THREE.WebGLRenderTarget(size, size);
+  for (const resource of [shadow.map, shadow.map.depthTexture, shadow.mapPass])
+    resource.addEventListener("dispose", () => disposed++);
+  const before = disposed;
+  releaseShadowTargets(shadow);
+  assert.equal(disposed - before, 3);
+  assert.equal(shadow.map, null);
+  assert.equal(shadow.mapPass, null);
+  assert.equal(shadow.needsUpdate, true);
+  releaseShadowTargets(shadow);
+  assert.equal(disposed - before, 3, "double cleanup is harmless");
+}
+console.log("Shadow target resize/disposal regression passed");
